# solana rpc the browser talks to
VITE_SOLANA_RPC=https://api.mainnet-beta.solana.com
# kora relayer json-rpc (fee payer, fee taken in usdc). unset = /api/kora, the server proxy
# VITE_KORA_URL=http://localhost:8090
# default near recipient for bridged near
VITE_NEAR_RECIPIENT=intents.near

# server only (vercel function api/agent.ts). never prefix with VITE_
# on vercel the ai gateway uses the deployment oidc token; set this only for local dev
AI_GATEWAY_API_KEY=
# optional, defaults to openai/gpt-5-mini (same as leash)
STROM_GATEWAY_MODEL=
# relayer (api/kora.ts): strom's own fee payer, a 64-byte json keypair array. server only, never VITE_
STROM_PAYER_KEY=
# optional: max lamports the relayer spends per instance per day (default 100000000 = 0.1 sol)
# KORA_DAILY_LAMPORTS=
# rpc the relayer proxy simulates on, to price what each tx costs the payer
SOLANA_RPC=https://api.mainnet-beta.solana.com
