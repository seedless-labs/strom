# kora relayer json-rpc (fee payer, fee taken in usdc)
VITE_KORA_URL=http://localhost:8090
# default near recipient for bridged near
VITE_NEAR_RECIPIENT=intents.near

# server only (vercel function api/agent.ts). never prefix with VITE_
ANTHROPIC_API_KEY=
